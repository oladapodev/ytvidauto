# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or even
#   fail to install them. In that case, the lock file should be added to .gitignore.
#Pipfile.lock

# poetry
#   Similar to Pipenv, poetry.lock is generally recommended to be tracked in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, poetry may install dependencies that don't work, or even
#   fail to install them. In that case, the lock file should be added to .gitignore.
#poetry.lock

# pdm
#   Similar to Pipenv, pdm.lock is generally recommended to be tracked in version control.
#pdm.lock
#   pdm build plugins may create files in .pdm-build/
.pdm-build/

# PEP 582; used by e.g. github.com/frenzy-one/python-pdm-template
